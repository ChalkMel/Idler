  spiritName: "\u0411\u0440\u0438\u043D"
  icon: {fileID: -6927620080093624194, guid: 296579dac2b41b848bc6ae5434d5973e, type: 3}
  description: "\u0411\u0440\u0438\u043D \u0433\u0438\u043F\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u0438 \u0438\u043D\u043E\u0433\u0434\u0430 \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u043E
    \u0443\u043F\u0435\u0440\u0442\u044B\u0439. \u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430
    \u0447\u0435\u043C-\u0442\u043E \u0437\u0430\u043D\u044F\u0442 \u0438 \u0443\u0432\u0435\u0440\u0435\u043D,
    \u0447\u0442\u043E \u0432\u0441\u0435 \u0435\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u043E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u044B. \u041F\u0440\u0430\u0432\u0434\u0430,
    \u0432 \u044D\u0442\u043E\u043C \u0443\u0432\u0435\u0440\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u043D. \u041B\u044E\u0431\u0438\u0442 \u042F\u0440\u0443 \u0437\u0430
    \u0435\u0435 \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435 \u043A
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438. \u041E\u043F\u0430\u0441\u0430\u0435\u0442\u0441\u044F
    \u0410\u0430\u043F\u043E, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
    \u0442\u043E\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439."
