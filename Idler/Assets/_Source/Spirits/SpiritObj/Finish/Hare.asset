  spiritId: 3
  spiritName: "\u041B\u0435\u043F\u0442\u043E\u2019\u043D"
  icon: {fileID: -8008446851867087563, guid: 395a850f47d002c43901204fad648f6c, type: 3}
  description: "\u041B\u0435\u043F\u0442\u043E\u2019\u043D \u043D\u0435 \u043E\u0441\u043E\u0431\u043E
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432 \u0438 \u043D\u0435
    \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E.
    \u041E\u043D \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D
    \u0432 \u0441\u0432\u043E\u0438 \u043C\u044B\u0441\u043B\u0438. \u0417\u0430
    \u043A\u0440\u0443\u0436\u043A\u043E\u0439 \u0447\u0430\u044F \u043C\u043E\u0436\u0435\u0442
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F,
    \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0442\u0435\u043C\u0438,
    \u043A\u043E\u0433\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u043C\u0438
    \u0441\u043B\u0443\u0448\u0430\u0442\u0435\u043B\u044F\u043C\u0438. \u041B\u0435\u043F\u0442\u043E\u2019\u043D
    \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E
    \u043B\u0430\u0434\u0438\u0442 \u0441 \u042F\u0440\u043E\u0439, \u0443\u0431\u0435\u0436\u0434\u0435\u043D\u043D\u044B\u0439,
    \u0447\u0442\u043E \u0435\u0435 \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435
    \u043A \u0432\u044B\u0433\u043E\u0434\u0435 \u043D\u0435 \u0431\u043E\u043B\u0435\u0435,
    \u0447\u0435\u043C \u0436\u0430\u0434\u043D\u043E\u0441\u0442\u044C. \u041B\u044E\u0431\u0438\u0442
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u0432\u044B\u0441\u043E\u043A\u043E\u043C
    \u0441 \u0410\u0430\u043F\u043E \u0438 \u0410\u0436\u0443\u0440\u043E\u043C. "
