--- !u!114 &811048908
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 811048903}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 256278ebf41b1e24f85c432282d62569, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  shopButton: {fileID: 1705136830}
  frogButton: {fileID: 1731289488}
  deerButton: {fileID: 26785462}
  duration: 1
  shopCloseButton: {fileID: 1246124767}
  closeButton:
  - {fileID: 1174166280}
  - {fileID: 1115022285}
  frogUI: {fileID: 1679134356}
  frogTalks:
  - "\u0412\u044B\u0431\u0435\u0440\u0438 \u043C\u0435\u0441\u0442\u043E, \u043A\u0443\u0434\u0430
    \u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F!"
  - "\u041F\u0435\u0449\u0435\u0440\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
    \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0443\u0433\u0430\u044E\u0449\u0435\u2026"
  - "\u201C\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043F\u043E\u0447\u0435\u043C\u0443
    \u043D\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044C\u044F \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F?
    \u0418\u0445 \u0447\u0442\u043E-\u0442\u043E \u043D\u0430\u043F\u0443\u0433\u0430\u043B\u043E?"
  - "\u0422\u044B \u043F\u0440\u0438\u043D\u0435\u0441 \u043C\u043D\u0435 \u043A\u0430\u043F\u0435\u043B\u044C\u043A\u0438?"
  frogUIText: {fileID: 1173658848}
  TeaUI: {fileID: 1941225224}
  deerTalks:
  - "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0432
    \u043C\u0438\u0440\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u0431\u043E\u043B\u0435\u0435 1500 \u0441\u043E\u0440\u0442\u043E\u0432 \u0447\u0430\u044F?
    \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u0431\u044B\u043B\u043E
    \u0431\u044B \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
    \u043A\u0430\u0436\u0434\u044B\u0439!"
  - "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C,
    \u0447\u0430\u0439\u043D\u044B\u0439 \u043A\u0443\u0441\u0442 \u043C\u043E\u0436\u0435\u0448\u044C
    \u0436\u0438\u0442\u044C \u0438 \u043F\u043B\u043E\u0434\u043E\u043D\u043E\u0441\u0438\u0442\u044C
    \u0431\u043E\u043B\u0435\u0435 \u0441\u0442\u0430 \u043B\u0435\u0442."
  - "\u0412 2019 \u0433\u043E\u0434\u0443 21 \u043C\u0430\u044F \u0441\u0442\u0430\u043B
    \u043E\u0442\u043C\u0435\u0447\u0430\u0442\u044C\u0441\u044F \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
    \u0434\u043D\u0435\u043C \u0447\u0430\u044F. \u0422\u044B \u043E\u0442\u043C\u0435\u0447\u0430\u043B?"
  - "\u041A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
    \u0432 \u043C\u0438\u0440\u0435 \u0432\u044B\u043F\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043E\u043A\u043E\u043B\u043E 15 \u0442\u044B\u0441\u044F\u0447 \u0447\u0430\u0448\u0435\u043A
    \u0447\u0430\u044F. \u0410 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u044F
    \u043F\u044C\u0435\u0448\u044C \u0442\u044B?"
  - "\u0412 \u0434\u0440\u0435\u0432\u043D\u0435\u043C \u041A\u0438\u0442\u0430\u0435
    \u0447\u0430\u0439\u043D\u044B\u0435 \u043B\u0438\u0441\u0442\u044C\u044F \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u0430\u043B\u0438
    \u0432 \u043A\u0438\u0440\u043F\u0438\u0447\u0438 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438,
    \u043A\u0430\u043A \u0434\u0435\u043D\u044C\u0433\u0438. \u0412\u043E\u0442 \u044D\u0442\u043E
    \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0441\u0442\u043E\u044F\u0449\u0430\u044F
    \u0432\u0430\u043B\u044E\u0442\u0430!"
  - "\u0422\u044B \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
    \u0447\u0430\u0439 \u0438\u0437\u043E\u0431\u0440\u0435\u043B\u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E?
    \u041D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0432\u044B\u0441\u0442\u0430\u0432\u043E\u043A
    \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0447\u0430\u0435\u043C \u0445\u043E\u0442\u0435\u043B
    \u0434\u0430\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
    \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u0441\u0432\u043E\u0435\u0433\u043E
    \u0447\u0430\u044F, \u043D\u043E \u0438\u0437-\u0437\u0430 \u0436\u0430\u0440\u044B
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0442\u0435\u043B \u0435\u0433\u043E
    \u043F\u0438\u0442\u044C, \u0438 \u0442\u043E\u0433\u0434\u0430 \u043E\u043D
    \u0440\u0435\u0448\u0438\u043B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
    \u0432 \u0447\u0430\u0439 \u043B\u0435\u0434."
  - "..\u041D\u0435\u0442, \u044F \u043D\u0435 \u043B\u0435\u0436\u0443 \u043D\u0430
    \u0437\u0435\u043C\u043B\u0435, \u0447\u0442\u043E\u0431\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043D\u0430 \u0442\u0435\u0431\u044F, \u0442\u0435\u0431\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F."
  DeerUI: {fileID: 451999220}
  deerUIText: {fileID: 1240714236}
  cauldronUI: {fileID: 149023135}
  shopUI: {fileID: 1380788318}
  credits: {fileID: 1007498499}
